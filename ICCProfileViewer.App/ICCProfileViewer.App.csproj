<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <SkiaSharpNativeAssetsVersion>3.119.4</SkiaSharpNativeAssetsVersion>
    <AvaloniaAngleNativeAssetsVersion>2.1.27548.20260419</AvaloniaAngleNativeAssetsVersion>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\ICCProfileViewer.Core\ICCProfileViewer.Core.csproj" />
    <ProjectReference Include="..\ICCProfileViewer.Lcms\ICCProfileViewer.Lcms.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource
      Include="ThirdPartyNotices/SoftwareNotices.txt"
      LogicalName="ICCProfileViewer.App.ThirdPartyNotices.SoftwareNotices.txt" />
    <EmbeddedResource
      Include="$(NuGetPackageRoot)skiasharp.nativeassets.win32/$(SkiaSharpNativeAssetsVersion)/THIRD-PARTY-NOTICES.txt"
      LogicalName="ICCProfileViewer.App.ThirdPartyNotices.SkiaSharpNativeAssets.txt" />
    <EmbeddedResource
      Include="$(NuGetPackageRoot)avalonia.angle.windows.natives/$(AvaloniaAngleNativeAssetsVersion)/LICENSE"
      LogicalName="ICCProfileViewer.App.ThirdPartyNotices.AvaloniaAngleNativeAssets.txt" />
  </ItemGroup>

  <PropertyGroup Condition="'$(BundleLcmsNativeLibrary)' == 'true'">
    <LcmsNativeLibraryPath Condition="'$(LcmsNativeLibraryPath)' == ''">$(MSBuildProjectDirectory)\..\Artifacts\native\win-x64\Release\lcms2.dll</LcmsNativeLibraryPath>
  </PropertyGroup>

  <ItemGroup Condition="'$(BundleLcmsNativeLibrary)' == 'true'">
    <Content Include="$(LcmsNativeLibraryPath)" Link="lcms2.dll">
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <ExcludeFromSingleFile>false</ExcludeFromSingleFile>
    </Content>
  </ItemGroup>

  <Target
    Name="ValidateBundledLcmsNativeLibrary"
    BeforeTargets="PrepareForPublish"
    Condition="'$(BundleLcmsNativeLibrary)' == 'true'">
    <Error
      Condition="'$(RuntimeIdentifier)' != 'win-x64'"
      Text="Bundled Little-CMS publishing currently supports only the win-x64 runtime identifier." />
    <Error
      Condition="'$(PublishSingleFile)' != 'true'"
      Text="Bundled Little-CMS publishing requires PublishSingleFile=true." />
    <Error
      Condition="'$(IncludeNativeLibrariesForSelfExtract)' != 'true'"
      Text="Bundled Little-CMS publishing requires IncludeNativeLibrariesForSelfExtract=true." />
    <Error
      Condition="!Exists('$(LcmsNativeLibraryPath)')"
      Text="Little-CMS was not found at '$(LcmsNativeLibraryPath)'. Run build-lcms.cmd Release x64 before publishing." />
  </Target>

</Project>

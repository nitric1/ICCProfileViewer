<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:ICCProfileViewer.App.ViewModels"
        xmlns:profiles="using:ICCProfileViewer.Core.Profiles"
        xmlns:controls="using:ICCProfileViewer.App.Controls"
        x:Class="ICCProfileViewer.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding WindowTitle}"
        Width="1340"
        Height="800"
        MinWidth="960"
        MinHeight="640"
        WindowStartupLocation="CenterScreen">
  <Grid RowDefinitions="Auto,*,Auto">
    <Border Grid.Row="0"
            Padding="16,12"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,0,0,1">
      <Grid ColumnDefinitions="Auto,16,*,Auto" VerticalAlignment="Center">
        <Button Grid.Column="0"
                Content="Open Profile"
                IsEnabled="{Binding CanOpenProfile}"
                Click="OpenProfileClick"
                ToolTip.Tip="Open an ICC or ICM color profile." />
        <StackPanel Grid.Column="2" Spacing="2">
          <TextBlock Text="{Binding ProfileName}" FontWeight="SemiBold" />
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{DynamicResource ThemeForegroundLowBrush}"
                     FontSize="12" />
          <ProgressBar IsVisible="{Binding IsLoading}"
                       IsIndeterminate="True"
                       Height="2"
                       Margin="0,4,0,0" />
        </StackPanel>
        <Border Grid.Column="3"
                Padding="10,5"
                CornerRadius="12"
                Background="{DynamicResource ThemeControlLowBrush}">
          <TextBlock Text="{Binding StateName}" FontSize="12" />
        </Border>
      </Grid>
    </Border>

    <Grid Grid.Row="1" ColumnDefinitions="400,*">
      <Border Grid.Column="0"
              Padding="18"
              BorderBrush="{DynamicResource ThemeBorderLowBrush}"
              BorderThickness="0,0,1,0">
        <ScrollViewer>
          <StackPanel Spacing="20">
            <StackPanel Spacing="10">
              <TextBlock Text="Profile Summary" FontSize="18" FontWeight="SemiBold" />
              <ItemsControl ItemsSource="{Binding SummaryRows}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ProfileMetadataRow">
                    <Grid ColumnDefinitions="120,*" ColumnSpacing="16" Margin="0,0,0,8">
                      <TextBlock Grid.Column="0"
                                 Text="{Binding Label}"
                                 Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                      <TextBlock Grid.Column="1"
                                 Text="{Binding Value}"
                                 TextWrapping="Wrap" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>

            <StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Tags" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Grid.Column="1"
                           Text="{Binding TagSummary}"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource ThemeForegroundLowBrush}" />
              </Grid>
              <Border Padding="14"
                      CornerRadius="6"
                      Background="{DynamicResource ThemeControlLowBrush}">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="56,56,*,Auto" ColumnSpacing="10">
                    <TextBlock Grid.Column="0" Text="Tag" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="1" Text="Type" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="Offset" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="3" Text="Size" FontWeight="SemiBold" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding Tags}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="profiles:IccTagInfo">
                        <Grid ColumnDefinitions="56,56,*,Auto" ColumnSpacing="10" Margin="0,2">
                          <TextBlock Grid.Column="0" Text="{Binding Signature}" FontFamily="Consolas" />
                          <TextBlock Grid.Column="1" Text="{Binding TypeSignature}" FontFamily="Consolas" />
                          <TextBlock Grid.Column="2" Text="{Binding Offset}" />
                          <TextBlock Grid.Column="3" Text="{Binding Size}" />
                        </Grid>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Open an ICC or ICM profile to inspect its tag table."
                             IsVisible="{Binding !HasTags}"
                             TextWrapping="Wrap"
                             Foreground="{DynamicResource ThemeForegroundLowBrush}" />
                </StackPanel>
              </Border>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>

      <Grid Grid.Column="1" RowDefinitions="*,Auto" Margin="18">
        <TabControl Grid.Row="0">
          <TabItem Header="CIE 1931 xy">
            <Border Margin="0,12,0,0"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                    BorderThickness="1">
              <controls:ChromaticityDiagramControl
                  DiagramType="Cie1931Xy"
                  ProfileGamut="{Binding ProfileGamut}"
                  ShowSrgb="{Binding ShowSrgb}"
                  ShowDisplayP3="{Binding ShowDisplayP3}"
                  ShowDciP3="{Binding ShowDciP3}"
                  ShowAdobeRgb="{Binding ShowAdobeRgb}"
                  ShowBt2020="{Binding ShowBt2020}"
                  ShowWhitePoints="{Binding ShowWhitePoints}"
                  MinHeight="400" />
            </Border>
          </TabItem>
          <TabItem Header="CIE 1976 u'v'">
            <Border Margin="0,12,0,0"
                    CornerRadius="8"
                    BorderBrush="{DynamicResource ThemeBorderMidBrush}"
                    BorderThickness="1">
              <controls:ChromaticityDiagramControl
                  DiagramType="Cie1976UvPrime"
                  ProfileGamut="{Binding ProfileGamut}"
                  ShowSrgb="{Binding ShowSrgb}"
                  ShowDisplayP3="{Binding ShowDisplayP3}"
                  ShowDciP3="{Binding ShowDciP3}"
                  ShowAdobeRgb="{Binding ShowAdobeRgb}"
                  ShowBt2020="{Binding ShowBt2020}"
                  ShowWhitePoints="{Binding ShowWhitePoints}"
                  MinHeight="400" />
            </Border>
          </TabItem>
        </TabControl>

        <StackPanel Grid.Row="1" Margin="0,16,0,0" Spacing="8">
          <Grid ColumnDefinitions="Auto,*">
            <TextBlock Grid.Column="0" Text="Reference gamuts" FontWeight="SemiBold" />
            <TextBlock Grid.Column="1"
                       Text="{Binding GamutStatusMessage}"
                       Margin="18,0,0,0"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                       FontSize="12" />
          </Grid>
          <WrapPanel Orientation="Horizontal">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
              <Path Data="M 0,5 L 28,5" Stroke="#0078D4" StrokeThickness="2" StrokeDashArray="8,4" Width="30" Height="10" />
              <CheckBox Content="sRGB" IsChecked="{Binding ShowSrgb}" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
              <Path Data="M 0,5 L 28,5" Stroke="#00A36C" StrokeThickness="2" StrokeDashArray="3,3" Width="30" Height="10" />
              <CheckBox Content="Display P3" IsChecked="{Binding ShowDisplayP3}" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
              <Path Data="M 0,5 L 28,5" Stroke="#E67E22" StrokeThickness="2" StrokeDashArray="10,3,2,3" Width="30" Height="10" />
              <CheckBox Content="DCI-P3 (DCI white)" IsChecked="{Binding ShowDciP3}" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
              <Path Data="M 0,5 L 28,5" Stroke="#8E44AD" StrokeThickness="2" StrokeDashArray="2,3" Width="30" Height="10" />
              <CheckBox Content="Adobe RGB (1998)" IsChecked="{Binding ShowAdobeRgb}" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,16,0">
              <Path Data="M 0,5 L 28,5" Stroke="#D81B60" StrokeThickness="2" StrokeDashArray="12,4" Width="30" Height="10" />
              <CheckBox Content="BT.2020" IsChecked="{Binding ShowBt2020}" Margin="4,0,0,0" />
            </StackPanel>
            <CheckBox Content="White points" IsChecked="{Binding ShowWhitePoints}" />
          </WrapPanel>
          <TextBlock Text="The chromaticity background is an on-screen visualization, not a color-accurate reproduction. Hover for coordinates; double-click the diagram to copy."
                     TextWrapping="Wrap"
                     Foreground="{DynamicResource ThemeForegroundLowBrush}"
                     FontSize="11" />
        </StackPanel>
      </Grid>
    </Grid>

    <Border Grid.Row="1"
            IsVisible="{Binding IsDropTargetVisible}"
            IsHitTestVisible="False"
            Margin="24"
            Padding="32"
            CornerRadius="12"
            BorderBrush="{DynamicResource ThemeBorderMidBrush}"
            BorderThickness="3"
            Background="{DynamicResource ThemeControlLowBrush}">
      <StackPanel HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Spacing="10">
        <TextBlock Text="{Binding DropTargetMessage}"
                   HorizontalAlignment="Center"
                   FontSize="24"
                   FontWeight="SemiBold" />
        <TextBlock Text="Only one profile can be opened at a time."
                   HorizontalAlignment="Center"
                   Foreground="{DynamicResource ThemeForegroundLowBrush}" />
      </StackPanel>
    </Border>

    <Border Grid.Row="2"
            Padding="14,9"
            BorderBrush="{DynamicResource ThemeBorderLowBrush}"
            BorderThickness="0,1,0,0">
      <StackPanel Spacing="3">
        <TextBlock Text="{Binding NativeRuntimeSummary}" FontSize="12" />
        <TextBlock Text="{Binding DiagnosticMessage}"
                   IsVisible="{Binding HasDiagnosticMessage}"
                   TextWrapping="Wrap"
                   Foreground="{DynamicResource SystemErrorTextColor}"
                   FontSize="12" />
        <Expander Header="{Binding DiagnosticsHeader}"
                  Margin="0,6,0,0">
          <StackPanel Spacing="6">
            <TextBlock Text="Select log text and press Ctrl+C to copy."
                       Foreground="{DynamicResource ThemeForegroundLowBrush}"
                       FontSize="11" />
            <TextBox Text="{Binding DiagnosticsText, Mode=OneWay}"
                     IsReadOnly="True"
                     AcceptsReturn="True"
                     TextWrapping="NoWrap"
                     FontFamily="Consolas"
                     FontSize="11"
                     MinHeight="100"
                     MaxHeight="200"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" />
          </StackPanel>
        </Expander>
      </StackPanel>
    </Border>
  </Grid>
</Window>
